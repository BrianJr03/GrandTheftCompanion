<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Loopback TCP from Android still requires the INTERNET permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".GtcApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gtc"
        tools:targetApi="34">

        <!-- Launcher trampoline. Finds the bottom display and starts
             HudActivity on it via setLaunchDisplayId, then finishes. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Gtc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The actual HUD. Supports being launched on an external
             display. taskAffinity + launchMode keep it in its own task
             so a back-press from the top screen doesn't tear it down. -->
        <activity
            android:name=".HudActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=":hud"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="false"
            android:theme="@style/Theme.Gtc" />
    </application>
</manifest>
