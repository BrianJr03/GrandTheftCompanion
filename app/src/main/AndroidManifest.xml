<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Loopback TCP from Android still requires the INTERNET permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Thumbstick lights go through Bifrost, the Thor's LED app, if the
         user has it. This is Bifrost's own install-time permission for
         sending it LED commands; the user still has to allow
         third-party control inside Bifrost before anything lights up. -->
    <uses-permission android:name="com.moonbench.bifrost.permission.CONTROL_LEDS" />

    <!-- Lets us tell "Bifrost is not installed" from "Bifrost did not
         answer". -->
    <queries>
        <package android:name="com.moonbench.bifrost" />
    </queries>

    <application
        android:name=".GtcApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gtc"
        tools:targetApi="34">

        <!-- Launcher trampoline. Finds the bottom display and starts
             HudActivity on it via setLaunchDisplayId, then finishes.
             excludeFromRecents keeps the trampoline from flashing into
             the recents list; HudActivity (its own task, taskAffinity
             :hud) is what the user sees instead. noHistory ensures the
             trampoline is never kept around on the back stack. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Gtc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The actual HUD. Supports being launched on an external
             display. taskAffinity + launchMode keep it in its own task
             so a back-press from the top screen doesn't tear it down.
             excludeFromRecents keeps the HUD (including the setup
             screen) out of the top-screen Recents list — the companion
             is glanceable, never something you'd Alt-Tab to. -->
        <activity
            android:name=".HudActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=":hud"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="false"
            android:theme="@style/Theme.Gtc" />
    </application>
</manifest>
