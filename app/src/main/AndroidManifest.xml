<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Loopback TCP from Android still requires the INTERNET permission.
         Also used by the in-app updater to talk to the GitHub Releases
         API and pull the signed APK. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Thumbstick lights go through Bifrost, the Thor's LED app, if the
         user has it. This is Bifrost's own install-time permission for
         sending it LED commands; the user still has to allow
         third-party control inside Bifrost before anything lights up. -->
    <uses-permission android:name="com.moonbench.bifrost.permission.CONTROL_LEDS" />

    <!-- Hand the downloaded APK to Android's package installer. The
         user still has to grant GTC "Install unknown apps" the first
         time; the updater sends them to Settings if they haven't. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Map page mirrors the top screen via MediaProjection, which
         Android only allows from a foreground service of type
         mediaProjection. The user approves each session in a dialog. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Lets us tell "Bifrost is not installed" from "Bifrost did not
         answer". -->
    <queries>
        <package android:name="com.moonbench.bifrost" />
    </queries>

    <application
        android:name=".GtcApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gtc"
        tools:targetApi="34">

        <!-- Launcher trampoline. Finds the bottom display and starts
             HudActivity on it via setLaunchDisplayId, then finishes.
             excludeFromRecents keeps the trampoline from flashing into
             the recents list; HudActivity (its own task, taskAffinity
             :hud) is what the user sees instead. noHistory ensures the
             trampoline is never kept around on the back stack. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Gtc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The actual HUD. Supports being launched on an external
             display. taskAffinity + launchMode keep it in its own task
             so a back-press from the top screen doesn't tear it down.
             excludeFromRecents keeps the HUD (including the setup
             screen) out of the top-screen Recents list — the companion
             is glanceable, never something you'd Alt-Tab to. -->
        <activity
            android:name=".HudActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=":hud"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="false"
            android:theme="@style/Theme.Gtc" />

        <!-- FileProvider only shares the single "updates" cache folder,
             where UpdateDownloader stashes the downloaded APK before
             handing a content:// URI to the package installer.
             Authority stays stable across debug/release because the
             suffix is a literal, not the applicationId. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Owns the screen-capture session for the map page. Started
             only after the user approves capture; stopped with it. -->
        <service
            android:name=".mirror.MirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
