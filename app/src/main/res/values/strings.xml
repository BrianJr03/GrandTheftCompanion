    <string name="settings_icon_cd">companion settings</string>
    <string name="settings_title">Settings</string>
    <string name="settings_auto_swipe_title">Auto-swipe to map while driving</string>
    <string name="settings_auto_swipe_body">When you get in a vehicle the bottom screen jumps to the minimap tab. When you get out it goes back to the tab you were on. Needs the mirror running to show anything.</string>
    <string name="settings_auto_mirror_title">Start the mirror automatically</string>
    <string name="settings_auto_mirror_body">On the map tab, launch the screen-capture permission prompt as soon as the connection is live, so you don\'t have to tap start. Android still asks every time it starts a new session.</string>
    <string name="settings_always_return_hud_title">Always return to the HUD when you get out</string>
    <string name="settings_always_return_hud_body">When you step out of a vehicle, go back to the HUD tab no matter which tab you were on. Overrides the default (which only pulls you back if you\'re still looking at the map).</string>
    <string name="map_driving_to">driving to</string>
    <string name="settings_controls_side_title">Map controls on the right</string>
    <string name="settings_controls_side_body">Move the map\'s lock, reset, pin and stop icons to the right of the mirror. Default puts them on the left. The map stays centred and keeps the same breathing room on the free side.</string>
    <string name="settings_section_minimap">Minimap</string>
    <string name="settings_section_plugin">Plugin</string>
    <string name="settings_reconnect_title">Reconnect to the plugin</string>
    <string name="settings_reconnect_body">Force a fresh connection to ThorBridge. Use if \"not connected\" sticks on a weapon switch and does not clear on its own.</string>
    <string name="settings_reconnect_button">Retry</string>
    <string name="snackbar_reconnect_success">Connected</string>
    <string name="snackbar_reconnect_failed">Could not reach the plugin</string>
    <string name="settings_close">Close</string>
    <string name="map_blips_title">map blips</string>
    <string name="map_blips_none">no blips yet — needs the game loaded and ThorBridgeV 0.3.0+ / ThorBridge at natives level 5</string>
