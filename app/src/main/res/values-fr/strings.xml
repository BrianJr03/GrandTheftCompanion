    <string name="settings_tab_arrows_body">Affiche des chevrons gauche et droit en bas de chaque onglet pour changer d\'onglet en un seul appui. Le balayage reste disponible.</string>
    <string name="settings_tab_arrows_style_title">Icône des boutons</string>
