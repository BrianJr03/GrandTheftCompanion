    <string name="tab_arrows_prev_cd">onglet précédent</string>
    <string name="tab_arrows_next_cd">onglet suivant</string>
    <string name="settings_auto_reapply_cheats_title">Réappliquer les bascules à la reconnexion</string>
    <string name="settings_auto_reapply_cheats_body">Après la reconnexion du compagnon (nouvelle session, relance du jeu), réactive toute bascule que vous aviez activée la dernière fois, plus toute triche instantanée armée par un appui long. Ne se déclenche qu\'une fois par connexion et uniquement quand le jeu est dans un état sûr (pas en pause, pas en changement de personnage, pas en cinématique).</string>
    <string name="settings_clear_cheats_title">Effacer les triches enregistrées</string>
    <string name="settings_clear_cheats_body">Oublie toute bascule activée et toute triche instantanée armée par appui long. La prochaine reconnexion repart de zéro. Le bouton de réapplication automatique ci-dessus reste inchangé.</string>
    <string name="settings_clear_cheats_button">Effacer</string>
