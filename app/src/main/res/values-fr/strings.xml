    <!-- Setup screen -->
    <string name="setup_title">NON CONNECTÉ</string>
    <string name="setup_subtitle">Compatible avec GTA IV et GTA V. Le compagnon écoute sur 127.0.0.1:47801 le plugin que vous installez.</string>
    <string name="setup_section">configuration gta iv</string>

    <string name="setup_step2_title">Lanceur de la famille Winlator avec variables d\'environnement</string>
    <string name="setup_step2_detail">GameHub Lite, Winlator / Winlator Cmod ou GameNative. Ajoutez WINEDLLOVERRIDES=dinput8=n,b dans les variables d\'environnement du jeu.</string>
    <string name="setup_step3_title">ThorBridge.asi + dinput8.dll dans le dossier du jeu</string>
    <string name="setup_step3_detail">Placez les deux à côté de GTAIV.exe. dinput8.dll est Ultimate ASI Loader (ThirteenAG, 32 bits) ; téléchargez-le depuis la page des releases d\'UAL.</string>
    <string name="setup_step4_title">Lancez GTA IV et chargez une sauvegarde</string>
    <string name="setup_step4_detail">L\'ASI reste en mode sans échec jusqu\'au démarrage du moteur de script. Une fois la sauvegarde chargée, cet écran disparaît automatiquement.</string>

