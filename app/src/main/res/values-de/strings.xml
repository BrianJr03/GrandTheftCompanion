    <!-- Setup screen -->
    <string name="setup_title">NICHT VERBUNDEN</string>
    <string name="setup_subtitle">Funktioniert mit GTA IV und GTA V. Der Begleiter hört auf 127.0.0.1:47801 auf das installierte Plugin.</string>
    <string name="setup_section">GTA-IV-Einrichtung</string>

    <string name="setup_step2_title">Launcher der Winlator-Familie mit Umgebungsvariablen</string>
    <string name="setup_step2_detail">GameHub Lite, Winlator / Winlator Cmod oder GameNative. Füge WINEDLLOVERRIDES=dinput8=n,b in den Umgebungsvariablen des Spiels hinzu.</string>
    <string name="setup_step3_title">ThorBridge.asi + dinput8.dll im Spielordner</string>
    <string name="setup_step3_detail">Lege beide neben GTAIV.exe ab. dinput8.dll ist der Ultimate ASI Loader (ThirteenAG, 32-Bit); herunterladen von der UAL-Releases-Seite.</string>
    <string name="setup_step4_title">GTA IV starten und einen Spielstand laden</string>
    <string name="setup_step4_detail">Das ASI bleibt im abgesicherten Modus, bis die Script-Engine läuft. Nach dem Laden eines Spielstands verschwindet dieser Bildschirm automatisch.</string>

