    <!-- HUD-page first-visit onboarding sheet -->
    <string name="hud_onboarding_title">Acerca del HUD</string>
    <string name="hud_onboarding_slide_hud_title">Lo que estás viendo</string>
    <string name="hud_onboarding_slide_hud_body">Tarjetas para el dinero, el arma y la munición, el vehículo y la velocidad, la emisora de radio, además de las barras de salud y blindaje abajo. Todo sigue al juego automáticamente.</string>
    <string name="hud_onboarding_slide_tap_title">Toca para actuar</string>
    <string name="hud_onboarding_slide_tap_body">Toca una emisora de radio para cambiarla. Toca la tarjeta de arma a pie (o mantén el botón de la rueda de armas en el mando) para elegir un arma.</string>
    <string name="hud_onboarding_slide_customs_title">Mantén pulsada la tarjeta del vehículo</string>
    <string name="hud_onboarding_slide_customs_body">¿En un coche? Mantener pulsada la tarjeta del vehículo abre Customs: pintura, piezas, rendimiento, ruedas, tintado, matrícula, neón. Busca el icono del lápiz pequeño junto al nombre del vehículo.</string>
    <string name="hud_onboarding_slide_tabs_title">Más pestañas</string>
    <string name="hud_onboarding_slide_tabs_body">Desliza a la izquierda para el mapa (iconos, ruta con un toque) o a la derecha para los trucos. El HUD se queda en el centro para que siempre sepas cómo volver.</string>

