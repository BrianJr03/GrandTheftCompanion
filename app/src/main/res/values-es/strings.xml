    <!-- Setup screen -->
    <string name="setup_title">GTC: NO CONECTADO</string>
    <string name="setup_subtitle">Se espera ThorBridge.asi en 127.0.0.1:47801.</string>
    <string name="setup_section">lista de configuración</string>

    <string name="setup_step2_title">Lanzador de la familia Winlator con variables de entorno</string>
    <string name="setup_step2_detail">GameHub Lite, Winlator / Winlator Cmod o GameNative. Añade WINEDLLOVERRIDES=dinput8=n,b en las variables de entorno del juego.</string>
    <string name="setup_step3_title">ThorBridge.asi + dinput8.dll en la carpeta del juego</string>
    <string name="setup_step3_detail">Coloca ambos junto a GTAIV.exe. dinput8.dll es Ultimate ASI Loader (ThirteenAG, 32 bits); descárgalo desde la página de releases de UAL.</string>
    <string name="setup_step4_title">Inicia GTA IV y carga una partida</string>
    <string name="setup_step4_detail">El ASI permanece en modo seguro hasta que el motor de script esté activo. Al cargar una partida esta pantalla desaparece automáticamente.</string>

